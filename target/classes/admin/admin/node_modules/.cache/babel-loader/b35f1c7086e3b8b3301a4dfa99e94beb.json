r\n      // // 使用刚指定的配置项和数据显示图表。\r\n      myChart.setOption(option);\r\n      //根据窗口的大小变动图表\r\n      window.onresize = function() {\r\n        myChart.resize();\r\n      };\r\n    }\r\n  }\r\n\r\n\r\n\r\n};\r\n</script>\r\n<style lang=\"scss\" scoped>\r\n#home-chart {\r\n  background: #ffffff;\r\n  padding: 20px 0;\r\n}\r\n</style>\r\n"],"sourceRoot":"src/components/home"}]}